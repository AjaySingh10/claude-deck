{
  "name": "claude-deck",
  "displayName": "Claude Deck",
  "description": "Supercharge Claude Code in one click - install Skills, MCP servers, Hooks, and manage Memory without touching a config file.",
  "version": "1.1.0",
  "publisher": "Ajax1029",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AjaySingh10/claude-deck"
  },
  "bugs": {
    "url": "https://github.com/AjaySingh10/claude-deck/issues"
  },
  "homepage": "https://github.com/AjaySingh10/claude-deck#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "mcp",
    "skills",
    "hooks",
    "ai",
    "llm",
    "skills-manager",
    "model-context-protocol",
    "slash-commands",
    "ai-assistant",
    "copilot-alternative",
    "claude-ai",
    "agent",
    "automation",
    "productivity",
    "workflow",
    "memory",
    "code-assistant"
  ],
  "activationEvents": [
    "onCommand:claude-deck.openTab"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "claude-deck.open",
        "title": "Claude Deck",
        "category": "Claude",
        "icon": "$(library)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-deck",
          "title": "Claude Deck",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "claude-deck": [
        {
          "type": "webview",
          "id": "claude-deck.mainView",
          "name": "Claude Deck"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
